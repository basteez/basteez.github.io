{{- /*
  RSS 2.0 feed. Adapted from Hugo's embedded rss.xml (Apache License 2.0, https://github.com/gohugoio/hugo).
  Differences: pages with `hidden: true` are left out; params.rssFullContent puts the whole post in the
  description; a cover image (see stage/cover.html) is put before the content.
*/ -}}
{{- $ctx := . -}}
{{- if .IsHome }}{{ $ctx = .Site }}{{ end -}}
{{- $pages := cond (or .IsHome .IsSection) $ctx.RegularPages $ctx.Pages -}}
{{- $pages = where $pages "Params.hidden" "!=" true -}}
{{- with .Site.Config.Services.RSS.Limit }}{{ if ge . 1 }}{{ $pages = first . $pages }}{{ end }}{{ end -}}
{{- $email := "" }}{{ $author := "" -}}
{{- with site.Params.author }}{{ if reflect.IsMap . }}{{ $email = .email | default "" }}{{ $author = .name | default "" }}{{ else }}{{ $author = . }}{{ end }}{{ end -}}
{{- $by := "" }}{{ with $email }}{{ $by = . }}{{ with $author }}{{ $by = printf "%s (%s)" $by . }}{{ end }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
        <link>{{ .Permalink }}</link>
        <description>Recent content {{ if ne .Title .Site.Title }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ .Site.Title }}</description>
        <generator>Hugo -- gohugo.io</generator>{{ with partialCached "stage/locale.html" . site.Language.Lang }}
        <language>{{ . }}</language>{{ end }}{{ with $by }}
        <managingEditor>{{ . }}</managingEditor>
        <webMaster>{{ . }}</webMaster>{{ end }}{{ with .Site.Copyright }}
        <copyright>{{ . }}</copyright>{{ end }}{{ if not .Date.IsZero }}
        <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
        {{- with .OutputFormats.Get "RSS" -}}
        {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
        {{- end -}}
        {{ range $pages }}
        {{- $p := . -}}
        {{- $content := cond site.Params.rssFullContent .Content .Summary -}}
        <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
        {{ with $by }}<author>{{ . }}</author>{{ end }}
        <guid>{{ .Permalink }}</guid>
        <description>
            {{- with partial "stage/cover.html" . -}}
            {{- if .exists -}}
                {{ "<" | html }}img src="{{ .permalink | absURL }}" alt="Featured image of post {{ $p.Title }}" {{ "/>" | html }}
            {{- end -}}
            {{- end -}}{{ safeHTML ($content | html) }}</description>
        </item>
        {{ end }}
    </channel>
</rss>
